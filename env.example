# Copy this file to `.env` in the project root (gitignored) and export variables before
# running the backend, OR set them in your Render/cloud dashboard.
# Suggested MySQL database name: travel_agency

# Server port (Render sets PORT automatically; default 8080 for local)
PORT=8080

# MySQL database connection
SPRING_DATASOURCE_URL=jdbc:mysql://your-mysql-host:3306/travel_agency?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=your_db_username
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT secret — generate a new one for production:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=your_jwt_secret_at_least_32_bytes_long

# Admin seed account (created only when users table is empty)
ADMIN_SEED_EMAIL=admin@nijotours.com
ADMIN_SEED_PASSWORD=your_strong_admin_password

# CORS — comma-separated, no spaces
# Production: https://nijotours.com,https://www.nijotours.com
CORS_ALLOWED_ORIGINS=https://nijotours.com,https://www.nijotours.com

# File upload directory (relative or absolute path)
# On Render, uploads are ephemeral — use external storage for persistence
FILE_UPLOAD_DIR=uploads

# JPA DDL mode (use "validate" in production, "update" for first deploy)
JPA_DDL_AUTO=update

# Token expiry in ms (86400000 = 24 hours)
JWT_EXPIRATION_MS=86400000

# Set to "true" to require admin approval before reviews go public
REVIEWS_REQUIRE_APPROVAL=false
