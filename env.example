# Copy this file to `.env` in the project root (gitignored) and load variables before
# `mvn spring-boot:run`, or set them in your host / Docker / cloud dashboard.
# Suggested MySQL database name: travel_agency

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travel_agency?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=admin-nijo

# At least 32 bytes as UTF-8. Generate a new secret for production, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=SB9BESEvvar956EPgme/fApr7/DdmHMsBoJQKQ63zBQ=

ADMIN_SEED_EMAIL=nijojapan@gmail.com
ADMIN_SEED_PASSWORD=nijo@123

# Local SPA (Vite). Production: https://nijrotravel.com (comma-separate multiple origins if needed)
