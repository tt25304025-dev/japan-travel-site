# Copy to .env and load in your shell, or set these in your hosting dashboard.
# Suggested MySQL database name: travel_agency

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/travel_agency?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=root
# Use your real MySQL password. Example local default in application.properties is 1234.
SPRING_DATASOURCE_PASSWORD=1234

JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_SEED_PASSWORD=choose-a-strong-password-for-first-admin
ADMIN_SEED_EMAIL=admin@yourdomain.com

# Optional: comma-separated origins for browser clients (not * in production with cookies)
CORS_ALLOWED_ORIGINS=*

SERVER_PORT=8080
